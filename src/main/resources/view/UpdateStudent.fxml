         <font>
            <Font size="18.0" />
         </font>
      </Text>
      <TextField fx:id="txtStudentId" layoutX="157.0" layoutY="87.0" prefHeight="35.0" prefWidth="184.0" style="-fx-background-radius: 50;" />
      <Text layoutX="42.0" layoutY="219.0" strokeType="OUTSIDE" strokeWidth="0.0" text="NIC : ">
         <font>
            <Font size="18.0" />
