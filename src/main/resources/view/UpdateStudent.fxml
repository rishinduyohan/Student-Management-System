<AnchorPane prefHeight="483.0" prefWidth="811.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.UpdateStudentController">
   <children>
      <Pane prefHeight="62.0" prefWidth="811.0" style="-fx-background-color: blue;">
